# Settings for compose.yaml. Copy this to .env, beside it, and keep that mode 0600: it can hold the admin token.

# The image. latest-spdk is the newest release; a version, such as 0.5.0-spdk, stays put.
#NVWEAVER_IMAGE=ghcr.io/xphyr/nvweaver:latest-spdk

# Where the API and web interface listen. Loopback only by default, which only this box can reach. To reach it from your
# network, set this box's address, and set TLS and a token or users below too, or it refuses passwords.
#NVWEAVER_LISTEN=192.0.2.10:8420

# The admin token, for the API and the command line utility: a long random string. Make one with "openssl rand -hex 32",
# in the nvweaver container's terminal in Container Manager, over SSH on the Synology, or on any Linux or Mac.
#NVWEAVER_API_TOKEN=

# HTTPS, from these PEM files in ./config: both, or neither.
#NVWEAVER_TLS_CERT=/etc/nvweaver/tls.crt
#NVWEAVER_TLS_KEY=/etc/nvweaver/tls.key

# Users for the web interface, as name:hash lines from "nvweaver passwd NAME", in ./config.
#NVWEAVER_USERS_FILE=/etc/nvweaver/users

# Scoped tokens, such as a Kubernetes cluster's, from "nvweaver token new NAME", in ./config.
#NVWEAVER_TOKENS_FILE=/etc/nvweaver/tokens

# SPDK's memory, in MB, taken at start: 1024 is the default, and 256 is too little to start.
#NVWEAVER_SPDK_MEM_MB=1024

# How writes that hosts need durable are made so. sync-attribute, the default, is SPDK as upstream ships it, which makes
# every write synchronous: safe on a power cut, but slow. fua is SPDK with nvweaver's patch, which isn't upstream, and makes
# only those writes synchronous: as safe in testing, and other writes 1.6 to 3.4 times faster on a Synology. Volumes made
# under either keep working when it's changed. See "Known limits" in the README, and decision 58.
#NVWEAVER_SPDK_DURABILITY=fua
