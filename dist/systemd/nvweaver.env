# Settings for the nvweaver service. This file can hold the API token, so keep it
# mode 0600. Restart the service after changing it.

# Where the API listens. It can export any unused block device on this host, so
# it stays on loopback unless you set an address here and a token below.
#NVWEAVER_LISTEN=127.0.0.1:8420
#NVWEAVER_API_TOKEN=

# Serve the API over HTTPS, using these PEM files. Set both, or neither. They're read again when they
# change, so renewing a certificate needs no restart. In the Quadlet, also enable its Volume= line for them.
#NVWEAVER_TLS_CERT=/etc/nvweaver/tls/tls.crt
#NVWEAVER_TLS_KEY=/etc/nvweaver/tls/tls.key

# true: "systemctl stop" and "restart" leave the target serving hosts, and the next
# start adopts it without disturbing them. To really stop it with this set, set it
# back to false, restart, then stop. Kernel target only.
#NVWEAVER_KEEP_ON_EXIT=false
