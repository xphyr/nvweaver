[Unit]
Description=NVMe over TCP target (kernel nvmet)
Documentation=file://@DOCDIR@/README.md
# A port on a specific IP can't start listening until that address exists.
Wants=network-online.target
After=network-online.target
# Retry for a while if an address or disk appears late in boot, then give up.
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=notify
ExecStart=@BINDIR@/nvweaverd
Environment=NVWEAVER_BACKEND=nvmet
# Settings here override the line above. See nvweaver.env for what can be set.
EnvironmentFile=-/etc/nvweaver/nvweaver.env
StateDirectory=nvweaver
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
# Restoring takes minutes with thousands of volumes.
TimeoutStartSec=900
# The kernel target takes each namespace down in turn: 46 s at 5,000.
TimeoutStopSec=300

# Sandboxing. The service needs to write configfs, load nvmet-tcp, and open
# block devices, which rules out ProtectKernelTunables, ProtectKernelModules,
# PrivateDevices and ProtectClock. See "Running under systemd" in the README
# before tightening any of this.
NoNewPrivileges=yes
# CAP_IPC_LOCK and CAP_SYS_NICE are for LVM, which locks itself in memory while devices are suspended.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_MODULE CAP_NET_BIND_SERVICE CAP_IPC_LOCK CAP_SYS_NICE
LimitMEMLOCK=infinity
AmbientCapabilities=
# Not strict: file-backed namespaces can be on any writable filesystem.
ProtectSystem=full
# LVM saves a backup of a volume group's metadata here on every change. Without this, it silently doesn't.
ReadWritePaths=-/etc/lvm
ProtectHome=yes
PrivateTmp=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount @module

[Install]
WantedBy=multi-user.target
