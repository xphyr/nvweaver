+/* A write with Force Unit Access must be durable before it completes. The bdev layer has no FUA flag, so the write is
+ * followed by a flush of its blocks, and the host is answered when that finishes: what Linux does for a disk without FUA.
+ */
+struct nvmf_bdev_ctrlr_fua_write {
+	struct spdk_nvmf_request	*req;
+	struct spdk_bdev_desc		*desc;
+	struct spdk_io_channel		*ch;
+	uint64_t			start_lba;
+	uint64_t			num_blocks;
+};
+
+static void
+nvmf_bdev_ctrlr_fua_write_done(struct spdk_bdev_io *bdev_io, bool success, void *cb_arg)
+{
+	struct nvmf_bdev_ctrlr_fua_write *fua = cb_arg;
+	struct spdk_nvmf_request *req = fua->req;
+	struct spdk_nvme_cpl *rsp = &req->rsp->nvme_cpl;
+	int rc;
+
+	if (spdk_unlikely(!success)) {
+		free(fua);
+		nvmf_bdev_ctrlr_complete_cmd(bdev_io, success, req);
+		return;
+	}
+	spdk_bdev_free_io(bdev_io);
+	rc = spdk_bdev_flush_blocks(fua->desc, fua->ch, fua->start_lba, fua->num_blocks,
+				    nvmf_bdev_ctrlr_complete_cmd, req);
+	free(fua);
+	if (spdk_unlikely(rc)) {
+		SPDK_ERRLOG("flush after a FUA write failed to start: %d\n", rc);
+		rsp->status.sct = SPDK_NVME_SCT_GENERIC;
+		rsp->status.sc = SPDK_NVME_SC_INTERNAL_DEVICE_ERROR;
+		spdk_nvmf_request_complete(req);
+	}
+}
